#!/bin/sh
set -e

# Fail fast if the chroot package install stage was skipped (e.g. a stale
# live-build stage marker left an empty chroot behind).
if [ ! -x /usr/sbin/ufw ] || [ ! -x /usr/bin/i3 ] || [ ! -x /usr/sbin/lightdm ]
then
	echo "ERROR: expected packages are missing from the chroot - the package install stage was skipped." >&2
	echo "       Fix: sudo lb clean --stage --chroot && lb config && sudo lb build" >&2
	exit 1
fi

# GNU shred is supplied by Debian's essential coreutils package (no separate
# shred package is needed). Fail the build if erase's backend is missing.
if ! command -v shred >/dev/null 2>&1; then
	echo "ERROR: shred is missing; restore the coreutils package and rebuild." >&2
	exit 1
fi

# Configure the image's firewall offline.
# A plain chroot shares the builder's network namespace.
test -f /etc/default/ufw
test -f /etc/ufw/ufw.conf

sed -i \
    -e 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' \
    -e 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' \
    -e 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' \
    /etc/default/ufw

sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf

grep -qx 'DEFAULT_INPUT_POLICY="DROP"' /etc/default/ufw
grep -qx 'DEFAULT_OUTPUT_POLICY="ACCEPT"' /etc/default/ufw
grep -qx 'DEFAULT_FORWARD_POLICY="DROP"' /etc/default/ufw
grep -qx 'ENABLED=yes' /etc/ufw/ufw.conf

systemctl enable ufw.service

# AppArmor
systemctl enable apparmor.service

# Apply our daemon configuration rather than the package-generated allowlist.
chmod 600 /etc/usbguard/rules.conf /etc/usbguard/usbguard-daemon.conf
systemctl enable usbguard.service

# Tor: installed but manual start only (sudo systemctl start tor)
systemctl disable tor.service || true

# Disable non-important services (only when the unit is actually present)
for _UNIT in bluetooth.service avahi-daemon.service
do
	if [ -e "/usr/lib/systemd/system/${_UNIT}" ] || [ -e "/lib/systemd/system/${_UNIT}" ]
	then
		systemctl disable "${_UNIT}" || true
	fi
done
