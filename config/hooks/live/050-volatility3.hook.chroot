#!/bin/sh
set -e

# Lock and hash-check the whole base dependency graph, not just the main wheel.
VOLATILITY3_REQUIREMENTS=/usr/share/secbian/volatility3-requirements.txt
VOLATILITY3_TMP=$(mktemp -d)
trap 'rm -rf "${VOLATILITY3_TMP}"' EXIT HUP INT TERM

# Download with the system pip before touching the old venv. Source builds and
# implicit dependency resolution are forbidden, including during download.
python3 -m pip download --only-binary=:all: --require-hashes --no-deps \
	--no-cache-dir -d "${VOLATILITY3_TMP}" -r "${VOLATILITY3_REQUIREMENTS}"

# Recreate at its final path so entry-point shebangs remain valid. This also
# removes stale packages/files when a lock changes or a build is resumed.
python3 -m venv --clear /opt/volatility3
/opt/volatility3/bin/python -m pip install --only-binary=:all: --require-hashes \
	--no-deps --no-index --no-cache-dir --find-links "${VOLATILITY3_TMP}" \
	-r "${VOLATILITY3_REQUIREMENTS}"
/opt/volatility3/bin/python -m pip check
/opt/volatility3/bin/vol --help >/dev/null
/opt/volatility3/bin/volshell --help >/dev/null

ln -sf /opt/volatility3/bin/vol /usr/local/bin/vol
ln -sf /opt/volatility3/bin/volshell /usr/local/bin/volshell
