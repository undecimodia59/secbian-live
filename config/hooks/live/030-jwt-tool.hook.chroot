#!/bin/sh
set -e

# jwt_tool pinned to release v2.3.0 (lightweight tag -> commit)
JWT_TOOL_TAG="v2.3.0"
JWT_TOOL_COMMIT="3bc7407cf2222d6a821dcc19c776e5a1b1cb9a9b"

if [ ! -d /opt/jwt_tool ]; then
	git -c advice.detachedHead=false clone --quiet --depth 1 --branch "${JWT_TOOL_TAG}" \
		https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool
fi

cd /opt/jwt_tool

# Verify the clone is exactly the pinned commit
if [ "$(git rev-parse HEAD)" != "${JWT_TOOL_COMMIT}" ]; then
	echo "jwt_tool: commit mismatch, expected ${JWT_TOOL_COMMIT}" >&2
	exit 1
fi

# Dependencies come from the Debian archive (python3-termcolor, python3-requests,
# python3-ratelimit, python3-pycryptodome - the latter provides the Cryptodome
# namespace jwt_tool imports). No PyPI install needed, so no sdist builds.
if ! python3 -c "import requests, termcolor, ratelimit; from termcolor import cprint; from Cryptodome.Signature import PKCS1_v1_5" 2>/dev/null
then
	echo "jwt_tool: Debian python packages incomplete, falling back to pinned PyPI wheels..." >&2
	python3 -m pip install --break-system-packages --no-cache-dir \
		termcolor==3.3.0 \
		pycryptodomex==3.24.1 \
		requests==2.34.2 \
		ratelimit==2.2.1
fi

chmod 755 /opt/jwt_tool/jwt_tool.py
ln -sf /opt/jwt_tool/jwt_tool.py /usr/local/bin/jwt_tool
