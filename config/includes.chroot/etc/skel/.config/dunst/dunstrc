[global]
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 180)
    origin = top-right
    offset = (18, 42)
    notification_limit = 4
    padding = 14
    horizontal_padding = 16
    frame_width = 2
    frame_color = "#34465b"
    separator_height = 2
    separator_color = frame
    corner_radius = 6
    font = DejaVu Sans 10
    format = "<b>%s</b>\n%b"
    markup = full
    word_wrap = yes
    ellipsize = end
    show_age_threshold = 60
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = yes
    history_length = 20

[urgency_low]
    background = "#101923"
    foreground = "#99aabc"
    frame_color = "#34465b"
    timeout = 4

[urgency_normal]
    background = "#101923"
    foreground = "#e8eef5"
    frame_color = "#52e0c4"
    timeout = 7

[urgency_critical]
    background = "#291820"
    foreground = "#fff0f2"
    frame_color = "#f2778b"
    timeout = 0
