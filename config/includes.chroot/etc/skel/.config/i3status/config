general {
    output_format = "i3bar"
    colors = true
    interval = 5
    color_good = "#52e0c4"
    color_degraded = "#e9c46a"
    color_bad = "#f2778b"
}

order += "memory"
order += "disk /"
order += "battery all"
order += "tztime local"

memory {
    format = "RAM %used / %total"
    threshold_degraded = "10%"
    format_degraded = "RAM %used / %total"
}

disk "/" {
    format = "SSD %used/%total"
    low_threshold = 10
    threshold_type = "percentage_avail"
}

battery all {
    format = "%status %percentage"
    format_down = ""
    status_chr = "AC"
    status_bat = "BAT"
    status_unk = "BAT"
    status_full = "FULL"
    low_threshold = 15
    threshold_type = "percentage"
}

tztime local {
    format = "%H:%M %d.%m.%Y"
}
