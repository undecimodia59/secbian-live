general {
    colors = true
    interval = 5
}

# order += "load"
# order += "memory"
order += "disk /"
# order += "ethernet _first_"
# order += "wireless _first_"
order += "battery all"
order += "tztime local"

load {
    format = "Load: %1min"
}

memory {
    format = "RAM: %used / %available"
    threshold_degraded = "1G"
    format_degraded = "RAM: %used / %available"
}

disk "/" {
    format = "Disk: %used/%avail"
}

ethernet _first_ {
    format_up = "E: %ip"
    format_down = "E: down"
}

wireless _first_ {
    format_up = "W: (%quality) %essid"
    format_down = "W: down"
}

battery all {
    format = "Bat: %percentage%"
}

tztime local {
    format = "%H:%M %d.%m.%Y"
}
