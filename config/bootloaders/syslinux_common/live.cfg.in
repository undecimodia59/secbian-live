label live-@FLAVOUR@
    menu label ^Secbian Live (@FLAVOUR@)
    menu default
    linux @LINUX@
    initrd @INITRD@
    append @APPEND_LIVE@

label live-@FLAVOUR@-failsafe
    menu label Secbian Live (@FLAVOUR@ fail-safe mode)
    linux @LINUX@
    initrd @INITRD@
    append @APPEND_LIVE_FAILSAFE@
